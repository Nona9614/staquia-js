{
  "compilerOptions": {
    "strict": true,
    "resolveJsonModule": true,
    "module": "EsNext",
    "moduleResolution": "Bundler",
    // The sources are bundled from this directory
    "rootDir": "./src",
    "target": "esnext",
    "lib": ["ESNext", "DOM"],
    // Types should go into this directory.
    // Removing this would place the .d.ts files
    // next to the .js files
    "outDir": "lib",
    // Tells TypeScript to read JS files, as
    // normally they are ignored as source files
    "allowJs": true,
    // Not generate d.ts files
    "declaration": false,
    "declarationDir": null,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "lib", "**/tests", "**/*.spec.ts", "docs/**/*"]
}
