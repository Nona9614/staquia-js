{
  "name": "staquia",
  "version": "0.5.0",
  "description": "The best library for tables and lists.",
  "homepage": "https://nona9614.github.io/staquia-js/",
  "bugs": {
    "url": "https://github.com/Nona9614/staquia-js/issues"
  },
  "type": "module",
