    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20.19"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Nona9614/staquia-js"
  },
  "devDependencies": {
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/chai": "^4.3.1",
    "@types/express": "^5.0.3",
    "@types/node": "^18.11.12",
    "chai": "^4.3.6",
    "express": "^5.1.0",
    "rollup": "^4.50.2",
    "rollup-plugin-dts": "^6.2.3",
    "tslib": "^2.8.1",
    "tsx": "^4.20.5",
    "typedoc": "^0.28.9"
  },
  "scripts": {
    "bundle": "tsx ./rollup.config.ts",
    "tests": "tsx watch --env-file .env tests/main.ts",
